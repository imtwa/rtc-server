# ============================================================================
# 环境变量
#
# 复制为 .env 后按注释填写。.env 含密钥，不要提交到仓库。
# ============================================================================

# ---------------------------------------------------------------------------
# 服务器公网 IP
#
# 必填。填公网 IP，不是域名、不是内网 IP。
#   阿里云/腾讯云轻量：控制台「实例详情」里的公网 IP
#
# 填错的后果：coturn 把内网地址写进 relay 候选，客户端拿到不可达地址，
# ICE 一直 checking 直到 failed，且日志里没有任何报错。
# ---------------------------------------------------------------------------
TURN_PUBLIC_IP=

# ---------------------------------------------------------------------------
# TURN 域名（下发给客户端）
#
# 客户端用这个域名连 TURN，DNS 解析到上面的公网 IP。
# 用域名而非 IP 的好处：换机器时只改 DNS，客户端不必重新发版。
#
# 建议使用独立子域名（如 rtc.example.com），需在 DNS 添加 A 记录指向上面的 IP
# ---------------------------------------------------------------------------
TURN_DOMAIN=

# ---------------------------------------------------------------------------
# 端口
#
# 全部避开惯例值，减少公网扫描器对信令与 TURN 端口的探测噪音。
#
# 改端口不需要动客户端 —— ICE 配置由信令服务运行时签发，
# 客户端拿到的就是新端口。只需同步安全组放行。
#
# 信令服务端口（默认 17300）在 docker-compose.yml 的 PORT 里改。
# coturn 走 host 网络，端口直接绑在宿主机上，由下面几项决定。
# ---------------------------------------------------------------------------

# TURN / STUN 监听端口（TCP + UDP）
TURN_PORT=34780

# TURN over TLS 端口（需给 coturn 配证书后才启用）
TURN_TLS_PORT=53490

# ---------------------------------------------------------------------------
# TURN 中继端口段（UDP）
#
# 容量换算：一个 allocation 占 1 个端口；一条走中继的连接需要两端各一个，
# 即 2 个。mesh 房间 N 人的总占用为 N×(N-1)。
#   100 个端口  -> 约 10 人同时全中继
#   16384 个    -> 上百人（理论上）
#
# 但实际先撞的是带宽墙：TURN 双向转发，每个流收一次发一次。
#   2 人全中继 约 2.4 Mbps
#   3 人全中继 约 7 Mbps
#   5 人全中继 约 24 Mbps
# 轻量服务器通常只有 3-5 Mbps 峰值，3 人就会到顶。
#
# 因此个人使用不必开满 —— 保持默认区间即可，够用且省防火墙规则。
# coturn 走 host 网络，范围大小不影响启动速度（无需逐端口映射）。
# ---------------------------------------------------------------------------
TURN_RELAY_MIN=49152
TURN_RELAY_MAX=65535

# ---------------------------------------------------------------------------
# TURN 长期密钥
#
# 必填。信令服务用它签发临时凭据，coturn 用同一值校验 HMAC。
# 两端必须完全一致，否则所有中继请求都会被拒。
#
# 生成：openssl rand -hex 32
# 建议用 hex，避免 / & | 等字符带来的转义问题。
# ---------------------------------------------------------------------------
TURN_SECRET=

# ---------------------------------------------------------------------------
# 跨域放行来源
#
# 原生 App 不受同源限制，保持 * 即可。
# 浏览器端（H5）上线后建议收窄，例如：ALLOW_ORIGIN=https://app.example.com
# ---------------------------------------------------------------------------
ALLOW_ORIGIN=*

# ============================================================================
# coturn 配置模板
#
# 本文件是模板：占位符由 entrypoint.sh 在容器启动时替换，
# 生成 /etc/coturn/turnserver.conf。不要直接当配置用。
#
# 占位符：
#   ${TURN_PUBLIC_IP}    服务器公网 IP（不是域名）
#   ${TURN_SECRET}       与信令服务共享的长期密钥
#   ${TURN_PORT}         STUN / TURN 监听端口
#   ${TURN_TLS_PORT}     TURN over TLS 监听端口
#   ${TURN_RELAY_MIN}    中继端口段起始
#   ${TURN_RELAY_MAX}    中继端口段结束
# ============================================================================

# ---------------------------------------------------------------------------
# 监听端口
#
# 刻意避开 3478/5349 —— 这两个是 TURN 的惯例端口，公网上有大量扫描器盯着
# 它们（探测开放中继、盗用带宽）。换端口能显著减少这类噪音流量。
#
# 改这里不需要动客户端：ICE 配置由信令服务运行时签发，
# 客户端拿到的就是新端口。
# ---------------------------------------------------------------------------
listening-port=${TURN_PORT}
tls-listening-port=${TURN_TLS_PORT}

# 监听所有网卡
listening-ip=0.0.0.0

# ---------------------------------------------------------------------------
# 对外公布的地址
#
# 这里必须填公网 IP，不能填域名。
#
# external-ip 的作用是告诉 coturn「我该把哪个地址写进 relay 候选」，
# 它对应本机网卡上的地址，而域名无法用于此。
# 域名只在客户端侧起作用（客户端用域名连过来，DNS 解析到本 IP）。
#
# 云主机是 1:1 NAT（内网 IP 不等于公网 IP），不显式指定的话 coturn 会把
# 内网地址写进候选，客户端拿到不可达地址，ICE 一直 checking 直到 failed。
# 这是自建 TURN 最常见的失败原因，且日志里没有任何报错。
# ---------------------------------------------------------------------------
external-ip=${TURN_PUBLIC_IP}

# ---------------------------------------------------------------------------
# 中继端口范围
#
# 一个 allocation 占 1 个端口，一条走中继的连接需两端各一个（共 2 个），
# mesh 房间 N 人总占用 N×(N-1)。默认 49152-65535（16384 个）是 coturn 惯例。
#
# 本镜像以 host 网络运行，范围大小不影响启动速度（无需逐端口映射）。
# 但实际瓶颈是带宽而非端口数 —— TURN 双向转发，3 人全中继约需 7 Mbps，
# 轻量服务器通常只有 3-5 Mbps。个人使用不必调整。
#
# 改这里须同步安全组放行范围。
# ---------------------------------------------------------------------------
min-port=${TURN_RELAY_MIN}
max-port=${TURN_RELAY_MAX}

# 凭据机制
fingerprint
lt-cred-mech

# ---------------------------------------------------------------------------
# 长期密钥（临时凭据）
#
# 信令服务按 username = "<过期时间戳>:<标识>"、
# credential = base64(HMAC-SHA1(secret, username)) 签发；
# coturn 用同一 secret 重算校验，并检查时间戳是否过期。
#
# realm 需与客户端请求中的 realm 匹配，固定值即可（与域名无关）。
# ---------------------------------------------------------------------------
use-auth-secret
static-auth-secret=${TURN_SECRET}
realm=rtc

# 禁止匿名与未授权访问；关闭 telnet 管理口
no-anonymous
no-cli

# ---------------------------------------------------------------------------
# 会话与配额
# ---------------------------------------------------------------------------

# 单会话最长存活（秒）。移动端长时间观影，给足 12 小时。
max-allocate-lifetime=43200

# 配额 0 表示不额外限制（仅受机器带宽约束）
user-quota=0
total-quota=0

# 安全：禁止中继到回环与组播地址，避免被当作内网探测跳板
no-loopback-peers
no-multicast-peers

# ---------------------------------------------------------------------------
# 日志：输出到 stdout，交由 Docker 收集
# ---------------------------------------------------------------------------
log-file=stdout
simple-log

# 可选：TLS 证书（启用 TURN over TLS 时必需，端口见 tls-listening-port）
# cert=/etc/coturn/certs/fullchain.pem
# pkey=/etc/coturn/certs/privkey.pem
